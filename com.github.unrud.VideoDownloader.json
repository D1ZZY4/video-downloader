{
    "app-id": "com.github.unrud.VideoDownloader",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "video-downloader",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-download/VideoDownloader:create"
    ],
    "modules": [
        {
            "name": "video-downloader",
            "builddir": true,
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release",
                "install -Dm755 target/release/video-downloader /app/bin/video-downloader",
                "install -Dm644 data/com.github.unrud.VideoDownloader.desktop.in /app/share/applications/com.github.unrud.VideoDownloader.desktop",
                "install -Dm644 data/com.github.unrud.VideoDownloader.svg /app/share/icons/hicolor/scalable/apps/com.github.unrud.VideoDownloader.svg",
                "install -Dm644 data/com.github.unrud.VideoDownloader-symbolic.svg /app/share/icons/hicolor/symbolic/apps/com.github.unrud.VideoDownloader-symbolic.svg",
                "install -Dm644 data/com.github.unrud.VideoDownloader.gschema.xml /app/share/glib-2.0/schemas/com.github.unrud.VideoDownloader.gschema.xml",
                "glib-compile-schemas /app/share/glib-2.0/schemas"
            ],
            "sources": [
                {
                    "type": "git",
                    "path": "."
                }
            ]
        }
    ]
}
